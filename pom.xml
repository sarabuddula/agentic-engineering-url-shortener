<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ADR-002: Spring Boot 3.x; 3.5.16 pinned by human decision 2026-10-20 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.agenticengineering</groupId>
    <artifactId>url-shortener</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>url-shortener</name>
    <description>Agentic Software Engineering System - URL Shortener</description>

    <properties>
        <!-- ADR-001: Java 21 LTS -->
        <java.version>21</java.version>
        <!-- Pinned at T003; recorded in research.md rows 7 and 9 -->
        <bucket4j.version>8.21.0</bucket4j.version>
        <swagger-request-validator.version>2.44.8</swagger-request-validator.version>
        <!-- Pinned at T004; LIC-01 license inventory -->
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
        <!-- Pinned at T009; NFR-004 architecture rules -->
        <archunit.version>1.5.1</archunit.version>
        <!-- Pinned at T106 (human decision 2026-10-21); DEP-02 vulnerability scan, profile dep-scan -->
        <dependency-check.version>13.0.0</dependency-check.version>
        <!-- DEP-02 remediation (human decision 2026-10-22, T107 attestation): overrides of Spring Boot 3.5.16 managed
             versions to the latest patch release at or above the OSV.dev fixed versions (Tomcat 10.1.58 was never
             published) - jackson-core/databind advisories, Tomcat CVE-2026-65182/65905/68525, log4j-api CVE-2026-49844 -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <tomcat.version>10.1.61</tomcat.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring JDBC behind repository interfaces (human decision 2026-10-21; replaced spring-boot-starter-data-jpa) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- ADR-003 storage (T008; version managed by Spring Boot) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- FR-047 / A-008a-d rate limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <!-- Test framework (T007; version managed by Spring Boot) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Plane and layer rules fail the build on forbidden dependencies (T009) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Executable OpenAPI contract validation in API contract tests -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-restassured</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- T010: executable fat jar (repackage); version managed by the Boot parent -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- T010: Failsafe runs *IT integration and e2e tests in mvn verify (plan section 10 execution wiring) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- LIC-01: license manifest committed under docs/compliance/ (target/ is gitignored) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <licensesOutputFile>${project.basedir}/docs/compliance/licenses.xml</licensesOutputFile>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- T106, DEP-02: vulnerability scan with OWASP DependencyCheck (pinned 13.0.0 by human decision 2026-10-21).
             Needs NVD network access; offline, DEP-02 degrades to attestation with a recorded note (plan section 8).
             The profile only produces the report: the FAIL threshold for "scan clean" is decided at T057. -->
        <profile>
            <id>dep-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
                            <failBuildOnCVSS>11</failBuildOnCVSS>
                            <!-- 13.x refuses to update NVD data without a key; read it from the environment, never from files -->
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
