<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ADR-002: Spring Boot 3.x; 3.5.16 pinned by human decision 2026-10-20 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.agenticengineering</groupId>
    <artifactId>url-shortener</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>url-shortener</name>
    <description>Agentic Software Engineering System - URL Shortener</description>

    <properties>
        <!-- ADR-001: Java 21 LTS -->
        <java.version>21</java.version>
        <!-- Pinned at T003; recorded in research.md rows 7 and 9 -->
        <bucket4j.version>8.21.0</bucket4j.version>
        <swagger-request-validator.version>2.44.8</swagger-request-validator.version>
        <!-- Pinned at T004; LIC-01 license inventory -->
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- FR-047 / A-008a-d rate limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <!-- Executable OpenAPI contract validation in API contract tests -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-restassured</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LIC-01: license manifest committed under docs/compliance/ (target/ is gitignored) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <licensesOutputFile>${project.basedir}/docs/compliance/licenses.xml</licensesOutputFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
